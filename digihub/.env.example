# Copie para ".env" (ignorado pelo Git) e preencha com os dados do seu projeto Supabase.
# Os valores abaixo são fictícios.

# Supabase > Connect > copie a string do "Session pooler" (IPv4, porta 5432) ou da conexão direta (IPv6).
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.SEU_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=troque-pela-senha-do-banco

# Origens do frontend permitidas no CORS (separadas por vírgula, sem barra no final)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcional
# DB_POOL_MAX_SIZE=5
# PORT=8080
